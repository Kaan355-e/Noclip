-- Emote + Fly Düzeltmeli Akıllı NoClip Döngüsü
local noclipConnection = RunService.Stepped:Connect(function()
    local char = player.Character
    if char and noclipEnabled then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if humanoid and humanoid.Health > 0 then
            -- 1. NoClip parçaları kapalı tutar (Wall Hop aktif kalır)
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            -- 2. Emote + Fly Kapandığında Karakterin Dümdüz Yere Yatmasını (Ragdoll) Engeller
            if humanoid.PlatformStand then
                humanoid.PlatformStand = false
            end
            if humanoid.Sit then
                humanoid.Sit = false
            end

            -- 3. Aşırı düşüş hızını sınırlandırıp dik tutma koruması
            if hrp then
                local currentVel = hrp.AssemblyLinearVelocity
                if currentVel.Y < -90 then
                    hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, -90, currentVel.Z)
                end
            end
        end
    end
end)

