-- Türkçe Karakter Yumuşatma
local function normalizeText(text)
    if not text then return "" end
    text = string.lower(text)
    text = string.gsub(text, "i̇", "i")
    text = string.gsub(text, "ı", "i")
    text = string.gsub(text, "ç", "c")
    text = string.gsub(text, "ğ", "g")
    text = string.gsub(text, "ö", "o")
    text = string.gsub(text, "ş", "s")
    text = string.gsub(text, "ü", "u")
    return text
end

