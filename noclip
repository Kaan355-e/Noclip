    langBtn.MouseButton1Click:Connect(function()
        currentLang = lang.code
        updateTexts()
        
        for _, item in pairs(langButtons) do
            if item.code == currentLang then
                item.btn.BackgroundColor3 = Color3.fromRGB(60, 100, 60)
            else
                item.btn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            end
        end
    end)

    table.insert(langButtons, {
        btn = langBtn, 
        name = normalizeText(lang.name), 
        code = normalizeText(lang.code), 
        aliases = lang.aliases, 
        defaultOrder = idx
    })
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = normalizeText(searchBox.Text)
    
    if query == "" then
        for _, item in ipairs(langButtons) do
            item.btn.Visible = true
            item.btn.LayoutOrder = item.defaultOrder
        end
        langScroll.CanvasPosition = Vector2.new(0, 0)
        return
    end

    for _, item in ipairs(langButtons) do
        local matchFound = false
        local priorityScore = 1000

        if string.find(item.name, query) then
            matchFound = true
            priorityScore = 1
        elseif string.find(item.code, query) then
            matchFound = true
            priorityScore = 2
        else
            for aliasIdx, alias in ipairs(item.aliases) do
                local normalizedAlias = normalizeText(alias)
                if string.find(normalizedAlias, query) then
                    matchFound = true
                    priorityScore = aliasIdx + 2
                    break
                end
            end
        end

        if matchFound then
            item.btn.Visible = true
            item.btn.LayoutOrder = priorityScore
        else
            item.btn.Visible = false
            item.btn.LayoutOrder = 9999
        end
    end
    
    langScroll.CanvasPosition = Vector2.new(0, 0)
end)

